# Template only. Do not enable until the minimum policy and operational acceptance pass.
OPERIA_ENV=production
OPERIA_AUTH_SIGNING_KEY_FILE=C:/ProgramData/OPERIA/secrets/signing-key.bin
OPERIA_LOCAL_RECOVERY_ENABLED=false
OPERIA_CORS_ORIGINS=["https://replace-with-your-gateway.invalid"]
# Never set OPERIA_AUTH_SIGNING_KEY together with OPERIA_AUTH_SIGNING_KEY_FILE.
# The file must contain exactly 32 raw bytes, with private file AND parent ACLs.
# Use a dedicated non-admin service account. This file does not provision a service or TLS.
