OPERIA_APP_NAME=OPERIA Forensic Tracing
OPERIA_ENV=local
OPERIA_API_PREFIX=/api
OPERIA_DATABASE_URL=sqlite:///./storage/operia_forensic_tracing.db
OPERIA_STORAGE_DIR=./storage
OPERIA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
# Deny outbound connectors and local recovery unless explicitly configured.
OPERIA_CONNECTOR_ALLOWED_HOSTS=[]
OPERIA_LOCAL_AI_ENABLED=false
OPERIA_LOCAL_AI_GATEWAY_ENABLED=false
OPERIA_LOCAL_AI_ALLOWED_MODELS=["mistral"]
# AppContainer has no loopback exemption. The internal broker requires both flags,
# an organization model grant and a case. See docs/LOCAL_AI_GATEWAY.md before enabling.
OPERIA_LOCAL_RECOVERY_ENABLED=false
# Signing key defaults to a persistent random storage/.auth-signing-key.
# Protect and back up that file; an operator may supply OPERIA_AUTH_SIGNING_KEY
# through a secret manager (random, at least 32 UTF-8 bytes). Never commit it.
OPERIA_HTTP_MAX_BODY_BYTES=8388608
OPERIA_HTTP_MAX_CONCURRENT_REQUESTS=8
OPERIA_HTTP_REQUESTS_PER_MINUTE=240
OPERIA_HTTP_AUTH_PER_MINUTE=20
